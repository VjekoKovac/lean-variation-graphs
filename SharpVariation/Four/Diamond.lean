    (p3 : x1 - x3 ≤ |x1 - x3|)
    (n3 : -(x1 - x3) ≤ |x1 - x3|)
    (p4 : x2 - x3 ≤ |x2 - x3|)
    (n4 : -(x2 - x3) ≤ |x2 - x3|)
    : (-2 : ℝ) * y0 + (-1 : ℝ) * y1 + (3 : ℝ) * y3 ≤ (3 / 4) * (|x0 - x1| + |x0 - x3| + |x1 - x2| + |x1 - x3| + |x2 - x3|) := by
  rcases u3 with u3 | u3
  · linear_combination 2 * l01 + (2 / 3 : ℝ) * l10 + (1 / 3 : ℝ) * l11 + 3 * u3 + (3 / 8 : ℝ) * p0 + (3 / 8 : ℝ) * n0 + (3 / 4 : ℝ) * n1 + (1 / 24 : ℝ) * p2 + (17 / 24 : ℝ) * n2 + (3 / 4 : ℝ) * n3 + (3 / 4 : ℝ) * n4
  · linear_combination 2 * l01 + l10 + 3 * u3 + (3 / 4 : ℝ) * p0 + (1 / 24 : ℝ) * p1 + (17 / 24 : ℝ) * n1 + (3 / 8 : ℝ) * p2 + (3 / 8 : ℝ) * n2 + (7 / 24 : ℝ) * p3 + (11 / 24 : ℝ) * n3 + (3 / 4 : ℝ) * p4

/-- The real piecewise-linear upper bound for the diamond graph. -/
theorem diamondUpper (x0 x1 x2 x3 y0 y1 y2 y3 : ℝ)
    (h0 : y0 = (max x0 (max ((x0 + x1 + x3) / 3) ((x0 + x1 + x2 + x3) / 4))))
    (h1 : y1 = (max x1 ((x0 + x1 + x2 + x3) / 4)))
    (h2 : y2 = (max x2 (max ((x1 + x2 + x3) / 3) ((x0 + x1 + x2 + x3) / 4))))
    (h3 : y3 = (max x3 ((x0 + x1 + x2 + x3) / 4)))
    : |y0 - y1| + |y0 - y3| + |y1 - y2| + |y1 - y3| + |y2 - y3| ≤ (3 / 4) * (|x0 - x1| + |x0 - x3| + |x1 - x2| + |x1 - x3| + |x2 - x3|) := by
  obtain ⟨l00, l01, l02, u0⟩ := maxBounds3 _ x0 ((x0 + x1 + x3) / 3) ((x0 + x1 + x2 + x3) / 4) h0
  obtain ⟨l10, l11, u1⟩ := maxBounds2 _ x1 ((x0 + x1 + x2 + x3) / 4) h1
  obtain ⟨l20, l21, l22, u2⟩ := maxBounds3 _ x2 ((x1 + x2 + x3) / 3) ((x0 + x1 + x2 + x3) / 4) h2
  obtain ⟨l30, l31, u3⟩ := maxBounds2 _ x3 ((x0 + x1 + x2 + x3) / 4) h3
  have p0 := le_abs_self (x0 - x1)
  have n0 := neg_le_abs (x0 - x1)
  have p1 := le_abs_self (x0 - x3)
  have n1 := neg_le_abs (x0 - x3)
  have p2 := le_abs_self (x1 - x2)
  have n2 := neg_le_abs (x1 - x2)
  have p3 := le_abs_self (x1 - x3)
  have n3 := neg_le_abs (x1 - x3)
  have p4 := le_abs_self (x2 - x3)
  have n4 := neg_le_abs (x2 - x3)
  rcases absChoice (y0 - y1) with h01 | h01
  all_goals rcases absChoice (y0 - y3) with h03 | h03
  all_goals rcases absChoice (y1 - y2) with h12 | h12
  all_goals rcases absChoice (y1 - y3) with h13 | h13
  all_goals rcases absChoice (y2 - y3) with h23 | h23
