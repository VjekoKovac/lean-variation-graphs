/-- The ratio at the unit mass on vertex 1 is 3/4. -/
theorem diamondSpike :
    (|(max 0 (max ((0 + 1 + 0) / 3) ((0 + 1 + 0 + 0) / 4))) - (max 1 ((0 + 1 + 0 + 0) / 4))| + |(max 0 (max ((0 + 1 + 0) / 3) ((0 + 1 + 0 + 0) / 4))) - (max 0 ((0 + 1 + 0 + 0) / 4))| + |(max 1 ((0 + 1 + 0 + 0) / 4)) - (max 0 (max ((1 + 0 + 0) / 3) ((0 + 1 + 0 + 0) / 4)))| + |(max 1 ((0 + 1 + 0 + 0) / 4)) - (max 0 ((0 + 1 + 0 + 0) / 4))| + |(max 0 (max ((1 + 0 + 0) / 3) ((0 + 1 + 0 + 0) / 4))) - (max 0 ((0 + 1 + 0 + 0) / 4))| : ℝ) = 
      (3 / 4) * (|0 - 1| + |0 - 0| + |1 - 0| + |1 - 0| + |0 - 0|) := by norm_num

