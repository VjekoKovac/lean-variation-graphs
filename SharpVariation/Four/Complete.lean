private theorem signed0 (x0 x1 x2 x3 y0 y1 y2 y3 : ℝ)
    (u0 : y0 ≤ x0 ∨ y0 ≤ ((x0 + x1 + x2 + x3) / 4))
    (u1 : y1 ≤ x1 ∨ y1 ≤ ((x0 + x1 + x2 + x3) / 4))
    (l20 : x2 ≤ y2)
    (l21 : ((x0 + x1 + x2 + x3) / 4) ≤ y2)
    (l30 : x3 ≤ y3)
    (l31 : ((x0 + x1 + x2 + x3) / 4) ≤ y3)
    (p0 : x0 - x1 ≤ |x0 - x1|)
    (n0 : -(x0 - x1) ≤ |x0 - x1|)
    (p1 : x0 - x2 ≤ |x0 - x2|)
    (n1 : -(x0 - x2) ≤ |x0 - x2|)
    (p2 : x0 - x3 ≤ |x0 - x3|)
    (n2 : -(x0 - x3) ≤ |x0 - x3|)
    (p3 : x1 - x2 ≤ |x1 - x2|)
    (n3 : -(x1 - x2) ≤ |x1 - x2|)
    (p4 : x1 - x3 ≤ |x1 - x3|)
    (n4 : -(x1 - x3) ≤ |x1 - x3|)
    (p5 : x2 - x3 ≤ |x2 - x3|)
    (n5 : -(x2 - x3) ≤ |x2 - x3|)
    : (3 : ℝ) * y0 + (1 : ℝ) * y1 + (-1 : ℝ) * y2 + (-3 : ℝ) * y3 ≤ (3 / 4) * (|x0 - x1| + |x0 - x2| + |x0 - x3| + |x1 - x2| + |x1 - x3| + |x2 - x3|) := by
  rcases u0 with u0 | u0
  all_goals rcases u1 with u1 | u1
  · linear_combination 3 * u0 + u1 + l21 + l30 + 2 * l31 + (3 / 4 : ℝ) * p0 + (3 / 4 : ℝ) * p1 + (3 / 4 : ℝ) * p2 + (3 / 4 : ℝ) * p3 + (1 / 2 : ℝ) * p4 + (1 / 4 : ℝ) * n4 + (3 / 4 : ℝ) * p5
  · linear_combination 3 * u0 + u1 + l21 + 3 * l31 + (3 / 4 : ℝ) * p0 + (3 / 4 : ℝ) * p1 + (3 / 4 : ℝ) * p2 + (3 / 4 : ℝ) * n3 + (3 / 4 : ℝ) * p4 + (3 / 4 : ℝ) * n5
  · linear_combination 3 * u0 + u1 + l20 + 3 * l30 + (1 / 4 : ℝ) * p0 + (1 / 2 : ℝ) * n0 + (1 / 2 : ℝ) * p1 + (1 / 4 : ℝ) * n1 + (3 / 4 : ℝ) * p2 + (3 / 4 : ℝ) * p3 + (3 / 4 : ℝ) * p4 + (3 / 4 : ℝ) * p5
  · linear_combination 3 * u0 + u1 + l20 + 3 * l30 + (5 / 8 : ℝ) * p0 + (1 / 8 : ℝ) * n0 + (3 / 8 : ℝ) * p1 + (3 / 8 : ℝ) * n1 + (5 / 8 : ℝ) * p2 + (1 / 8 : ℝ) * n2 + (3 / 4 : ℝ) * p3 + (3 / 4 : ℝ) * p4 + (3 / 4 : ℝ) * p5

