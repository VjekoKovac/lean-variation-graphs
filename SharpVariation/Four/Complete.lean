    (|(max 1 ((1 + 0 + 0 + 0) / 4)) - (max 0 ((1 + 0 + 0 + 0) / 4))| + |(max 1 ((1 + 0 + 0 + 0) / 4)) - (max 0 ((1 + 0 + 0 + 0) / 4))| + |(max 1 ((1 + 0 + 0 + 0) / 4)) - (max 0 ((1 + 0 + 0 + 0) / 4))| + |(max 0 ((1 + 0 + 0 + 0) / 4)) - (max 0 ((1 + 0 + 0 + 0) / 4))| + |(max 0 ((1 + 0 + 0 + 0) / 4)) - (max 0 ((1 + 0 + 0 + 0) / 4))| + |(max 0 ((1 + 0 + 0 + 0) / 4)) - (max 0 ((1 + 0 + 0 + 0) / 4))| : ℝ) = 
      (3 / 4) * (|1 - 0| + |1 - 0| + |1 - 0| + |0 - 0| + |0 - 0| + |0 - 0|) := by norm_num

